{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Reports",
    "description": "AI generated incident reports",
    "required": [
      "incidentId",
      "title",
      "reportType",
      "generatedBy"
    ],
    "properties": {
      "_id": {
        "bsonType": "objectId",
        "description": "Unique report identifier"
      },
      "incidentId": {
        "bsonType": "objectId",
        "description": "Associated incident ID"
      },
      "title": {
        "bsonType": "string",
        "description": "Report title",
        "minLength": 1,
        "maxLength": 200
      },
      "reportType": {
        "bsonType": "string",
        "description": "Report type",
        "enum": [
          "SUMMARY",
          "DETAILED",
          "EXECUTIVE",
          "TECHNICAL"
        ]
      },
      "content": {
        "bsonType": "string",
        "description": "Report content (markdown or HTML)"
      },
      "format": {
        "bsonType": "string",
        "description": "Report format",
        "enum": [
          "PDF",
          "MD",
          "HTML",
          "TXT"
        ]
      },
      "filePath": {
        "bsonType": "string",
        "description": "Generated file path"
      },
      "fileSize": {
        "bsonType": "long",
        "description": "File size in bytes"
      },
      "generatedBy": {
        "bsonType": "objectId",
        "description": "User ID or AI agent ID"
      },
      "isAIGenerated": {
        "bsonType": "bool",
        "description": "Whether generated by AI"
      },
      "metadata": {
        "bsonType": "object",
        "description": "Report metadata",
        "properties": {
          "wordCount": {
            "bsonType": "int",
            "description": "Word count"
          },
          "pageCount": {
            "bsonType": "int",
            "description": "Page count (for PDF)"
          },
          "generationTime": {
            "bsonType": "long",
            "description": "Generation time in milliseconds"
          }
        }
      },
      "createdAt": {
        "bsonType": "date",
        "description": "Report generation timestamp"
      }
    }
  }
}