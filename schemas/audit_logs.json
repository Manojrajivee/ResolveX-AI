    "required": [
      "userId",
      "action",
      "entityType",
      "timestamp"
    ],
    "properties": {
      "_id": {
        "bsonType": "objectId",
        "description": "Unique audit log identifier"
      },
      "userId": {
        "bsonType": "objectId",
        "description": "User ID who performed the action"
      },
