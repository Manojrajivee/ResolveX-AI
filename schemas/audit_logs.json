          "USER_LOGGED_OUT",
          "USER_CREATED",
          "USER_UPDATED",
          "USER_DELETED",
          "FILE_UPLOADED",
          "RUNBOOK_DELETED",
          "REPORT_GENERATED",
          "INCIDENT_CREATED",
          "INCIDENT_UPDATED",
          "INCIDENT_DELETED",
          "COMMAND_EXECUTED",
          "SETTINGS_UPDATED",
          "ROLE_ASSIGNED",
          "ROLE_REVOKED",
          "APPROVAL_GRANTED",
          "APPROVAL_DENIED"
        ]
      },
      "entityType": {
        "bsonType": "string",
        "description": "Type of entity affected",
        "enum": [
          "USER",
          "RUNBOOK",
          "INCIDENT",
          "REPORT",
          "COMMAND",
          "ROLE",
          "SETTING"
        ]
      },
      "entityId": {
        "bsonType": "objectId",
        "description": "ID of entity affected"
      },
      "entityName": {
        "bsonType": "string",
        "description": "Name of entity for quick reference",
        "maxLength": 200
      },
      "description": {
        "bsonType": "string",
        "description": "Human-readable description of the action",
        "maxLength": 1000
      },
      "ipAddress": {
        "bsonType": "string",
        "description": "Client IP address",
        "maxLength": 50
      },
      "userAgent": {
        "bsonType": "string",
        "description": "Client user agent",
        "maxLength": 500
      },
      "requestMethod": {
        "bsonType": "string",
        "description": "HTTP method",
        "enum": [
          "GET",
          "POST",
          "PUT",
          "PATCH",
          "DELETE"
        ]
      },
      "requestPath": {
        "bsonType": "string",
        "description": "Request path",
        "maxLength": 500
      },
      "changes": {
        "bsonType": "object",
        "description": "Before/after changes for update actions",
        "properties": {
          "before": {
            "bsonType": "object",
